{
  "name": "Ember Code",
  "short_name": "Ember",
  "description": "Generate and scan Ember codes: a standard QR burning inside a fire whose embers are a second code.",
  "id": "./scan/",
  "start_url": "./scan/",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Scan", "url": "./scan/", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Generate", "url": "./", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
